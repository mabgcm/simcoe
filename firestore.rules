rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() { return request.auth != null; }
    function isOwner(userId) { return isAuth() && request.auth.uid == userId; }
    function isAdmin() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }
    function isMember() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.membershipStatus == 'active';
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuth() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }
    match /news/{docId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }
    match /updates/{docId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }
    match /events/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /event_registrations/{docId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuth();
      allow update: if isAdmin();
    }
    match /newcomers_guide/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /community_posts/{docId} {
      allow read: if isMember() || isAdmin();
      allow create: if isMember();
      allow update: if isOwner(resource.data.authorId) || isAdmin();
      allow delete: if isOwner(resource.data.authorId) || isAdmin();
    }
    match /memberships/{docId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if isAdmin();
    }
    match /donations/{docId} {
      allow read: if isAdmin();
      allow create: if true;
    }
    match /sponsors/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
